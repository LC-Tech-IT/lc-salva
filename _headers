# LC Salva — Encabezados HTTP para Cloudflare Pages
# Las reglas que coinciden se combinan. Por defecto Pages ya envía
# "Cache-Control: public, max-age=0, must-revalidate" + ETag (HTML, CSS y JS
# siempre frescos tras cada despliegue), por eso solo se ajustan imágenes y páginas sensibles.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cdn.jsdelivr.net https://checkout.wompi.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://bfxolduuqkrhyfjrvwsx.supabase.co; connect-src 'self' https://bfxolduuqkrhyfjrvwsx.supabase.co wss://bfxolduuqkrhyfjrvwsx.supabase.co https://*.wompi.co; frame-src https://checkout.wompi.co https://*.wompi.co https://maps.google.com https://www.google.com; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), usb=()

# Imágenes: rara vez cambian (las del carrusel se versionan con ?v=)
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400

# Ficha médica de emergencia: nunca desde caché y fuera de buscadores
/ficha*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Panel con datos personales: nunca desde caché y fuera de buscadores
/admin*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
